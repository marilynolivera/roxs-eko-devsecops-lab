<% layout('content') %>

<div class="jumbotron">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 300px;">
            <h1>¡Bienvenido a NodeVulnerable! 🛡️</h1>
            <p style="font-size: 18px; margin-bottom: 15px;">
                Aplicación de prueba para analizadores de código de seguridad
            </p>
            <p style="font-size: 16px; color: #64748b;">
                Esta tienda virtual contiene vulnerabilidades intencionales del OWASP Top 10 para fines educativos
            </p>
        </div>
        <div style="text-align: right;">
            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px 30px; border-radius: 15px; display: inline-block; box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);">
                <div style="font-size: 14px; opacity: 0.9; margin-bottom: 5px;">Total de Productos</div>
                <div style="font-size: 36px; font-weight: 700;"><%= products.length %></div>
            </div>
        </div>
    </div>
</div>

<div style="margin-bottom: 30px;">
    <h2 style="color: #1e293b; font-weight: 700; margin-bottom: 20px; display: flex; align-items: center;">
        <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 4px; height: 30px; margin-right: 15px; border-radius: 2px;"></span>
        Catálogo de Productos
    </h2>
</div>

<div id="grid">
    <% for( var i=0; i < products.length; i++)  {
        var product = products[i];;
    %>
        <div class="item">
            <div class="thumbnail">
                <a href="/products/detail?id=<%-product.id%>" style="position: relative; display: block; overflow: hidden;">
                    <img src="/images/<%-product.image%>" alt="<%-product.name%>">
                    <div style="position: absolute; top: 10px; right: 10px; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 8px 15px; border-radius: 20px; font-weight: 700; font-size: 16px; box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);">
                        $<%-product.price%>
                    </div>
                </a>
                <div class="caption">
                    <h4 style="margin-bottom: 10px;">
                        <a href="/products/detail?id=<%-product.id%>" style="color: #1e293b; text-decoration: none; transition: color 0.3s ease;">
                            <%-product.name%>
                        </a>
                    </h4>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 15px;"><%-product.description%></p>
                    <a href="/products/detail?id=<%-product.id%>" class="btn btn-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; padding: 8px 20px; font-weight: 600; width: 100%; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);">
                        Ver Detalles →
                    </a>
                </div>
            </div>
        </div>
    <% }%>
</div>

<style>
.thumbnail .caption h4 a:hover {
    color: #667eea !important;
}
.thumbnail .caption .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5) !important;
}
</style>